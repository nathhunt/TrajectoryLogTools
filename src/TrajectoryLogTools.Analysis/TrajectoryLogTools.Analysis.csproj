<Project Sdk="Microsoft.NET.Sdk">
  <!-- Analyses built on the engine: delivery comparison, Eclipse MLC reconstruction and the
       comparison of a log with its DICOM RT Plan (read with fo-dicom).
       Also built for .NET Framework 4.8, like the engine. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <RootNamespace>TrajectoryLogTools.Analysis</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="fo-dicom" Version="5.2.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrajectoryLogTools.Core\TrajectoryLogTools.Core.csproj" />
  </ItemGroup>
</Project>
