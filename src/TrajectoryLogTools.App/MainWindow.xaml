<Window x:Class="TrajectoryLogTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrajectoryLogTools.App.Views"
        Title="{Binding Title}"
        Width="1280" Height="860" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Text="{Binding EnvironmentText}" Opacity="0.55" FontSize="11" Margin="4,6,4,0" TextTrimming="CharacterEllipsis" />
        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Convert &amp; export">
                <views:ConvertView DataContext="{Binding Convert}" />
            </TabItem>
            <TabItem Header="Log viewer">
                <views:ViewerView DataContext="{Binding Viewer}" />
            </TabItem>
            <TabItem Header="Compare">
                <views:CompareView DataContext="{Binding Compare}" />
            </TabItem>
            <TabItem Header="Eclipse MLC">
                <views:MlcView DataContext="{Binding Mlc}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
