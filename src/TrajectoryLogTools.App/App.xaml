<Application x:Class="TrajectoryLogTools.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="Light">
    <!-- Colours come from the Fluent theme's resources (DynamicResource), so light and dark both work.
         The shared styles (Icon, Secondary, Box, ...) and converters are in TrajectoryLogTools.Wpf/Styles.xaml. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Styles and converters shared with the v4.0 converter app -->
                <ResourceDictionary Source="pack://application:,,,/TrajectoryLogTools.Wpf;component/Styles.xaml" />
                <!-- This app's own templates (the key-fact card) -->
                <ResourceDictionary Source="Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
