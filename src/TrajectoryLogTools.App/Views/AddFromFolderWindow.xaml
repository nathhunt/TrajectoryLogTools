<Window x:Class="TrajectoryLogTools.App.Views.AddFromFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:TrajectoryLogTools.Wpf;assembly=TrajectoryLogTools.Wpf"
        Title="Add logs from a folder" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}" ShowInTaskbar="False">
    <StackPanel Margin="24,18,24,18">
        <TextBlock Text="Add logs from a folder" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Padding="12,5" Margin="8,0,0,0" />
            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Folder" />
        </DockPanel>
        <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,10,0,0" />
        <wpf:LogFilterPanel DataContext="{Binding Filter}" Margin="0,10,0,0" />

        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Dates are dd/mm/yyyy; times are 24-hour. The treatment date and time are the _yyyyMMddHHmmss time stamp in the file name, or the file's modified time when the name has none." />
        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add" Click="Add_Click" IsEnabled="{Binding CanAdd}" Style="{DynamicResource AccentButtonStyle}" Padding="18,6" IsDefault="True" />
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
