<UserControl x:Class="TrajectoryLogTools.App.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Input -->
        <Border Grid.Row="0" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <TextBlock Text="Input" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="Folder of log files" IsChecked="{Binding FolderMode}" Margin="0,0,24,0" GroupName="InputKind" />
                    <RadioButton Content="Single log file" GroupName="InputKind" IsChecked="{Binding FolderMode, Converter={StaticResource Not}}" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseInputCommand}" Margin="8,0,0,0" MinWidth="96" />
                </Grid>
                <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding FolderMode}">
                    <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <CheckBox Content="Only logs treated from" IsChecked="{Binding UseDateRange}" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="8,0" Width="150" IsEnabled="{Binding UseDateRange}" />
                    <TextBlock Text="to" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="8,0" Width="150" IsEnabled="{Binding UseDateRange}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The treatment date comes from the _yyyyMMddHHmmss time stamp in the file name, or from the file's modified date when the name has none." />
            </StackPanel>
        </Border>

        <!-- Output -->
        <Border Grid.Row="1" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <TextBlock Text="Output" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Export to folder (file names are kept; subfolders are mirrored):" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" MinWidth="96" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox Content="Convert v5.1 to v4.0 (.bin)" IsChecked="{Binding ToV4}" FontWeight="SemiBold" />
                        <StackPanel Margin="24,4,0,0" IsEnabled="{Binding ToV4}">
                            <CheckBox Content="Keep machine specifier / serial" IsChecked="{Binding KeepMachineInfo}" />
                            <CheckBox Content="Save removed time axis (_time.csv)" IsChecked="{Binding TimeCsv}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox Content="Export CSV (&lt;name&gt;.csv)" IsChecked="{Binding ToCsv}" FontWeight="SemiBold" />
                        <StackPanel Margin="24,4,0,0" IsEnabled="{Binding ToCsv}">
                            <CheckBox Content="Full dump instead (_full.csv)" IsChecked="{Binding FullCsv}" />
                            <CheckBox Content="Leave out MLC columns" IsChecked="{Binding NoMlc}" IsEnabled="{Binding CsvOptionsEnabled}" />
                            <CheckBox Content="Actual values only" IsChecked="{Binding ActualOnly}" IsEnabled="{Binding CsvOptionsEnabled}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <CheckBox Content="Raw dump (&lt;name&gt;.txt)" IsChecked="{Binding Dump}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,0"
                                   Text="The whole file as readable text, exactly as stored, with byte offsets. Works on damaged files too." />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="Overwrite existing output files" IsChecked="{Binding Overwrite}" Margin="0,0,24,0" />
                    <CheckBox Content="Process logs whose CRC does not verify" IsChecked="{Binding IgnoreCrc}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Buttons + progress -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Find files" Command="{Binding FindCommand}" MinWidth="110" />
            <Button Grid.Column="1" Content="Convert" Command="{Binding RunCommand}" MinWidth="110" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="110" Margin="8,0,0,0" />
            <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" />
                <TextBlock Text="{Binding Status}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="4" Content="Open output folder" Command="{Binding OpenOutputCommand}" MinWidth="140" />
        </Grid>

        <TextBox Grid.Row="3" Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource Mono}" TextChanged="Log_TextChanged" />
    </Grid>
</UserControl>
