<UserControl x:Class="TrajectoryLogTools.App.Views.PatientTag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <!-- The patient ID, the same everywhere: person icon and the ID. Collapses when there is none. -->
    <StackPanel Orientation="Horizontal" ToolTip="Patient ID from the log header">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding Id, ElementName=Root}" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
