<UserControl x:Class="TrajectoryLogTools.App.Views.MlcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: inputs and options -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Delivery log" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseLogCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding LogInfo}" Style="{StaticResource Hint}" />
                        <CheckBox Content="Ignore CRC" IsChecked="{Binding IgnoreCrc}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Fields and Eclipse templates" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A template is the Eclipse MLC export of the same beam. With templates, their header, meterset weights, jaws and angles are kept and only the leaf positions are replaced - the safest way to get a file Eclipse accepts. Add them all at once; they are matched to the fields by control points and gantry angle." />
                        <Button Content="Add templates..." Command="{Binding AddTemplatesCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Subbeams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Top" Margin="0,2,6,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="Subbeam" /> <Run Text="{Binding Subbeam, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Info}" Opacity="0.75" TextWrapping="Wrap" />
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="Template: " /><Run Text="{Binding TemplateName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding TemplateInfo}" Opacity="0.75" TextWrapping="Wrap"
                                                           Visibility="{Binding TemplateInfo, Converter={StaticResource NotEmptyToVisibility}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="..." ToolTip="Choose the template for this field" VerticalAlignment="Top" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.BrowseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="✕" ToolTip="No template" VerticalAlignment="Top" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.ClearTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Leaf positions" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <RadioButton Content="Actual (as delivered)" IsChecked="{Binding UseActualPositions}" GroupName="Pos" Margin="0,0,16,0" />
                            <RadioButton Content="Expected" IsChecked="{Binding UseActualPositions, Converter={StaticResource Not}}" GroupName="Pos" />
                        </StackPanel>
                        <TextBlock Text="Where each snapshot sits between control points" FontWeight="SemiBold" />
                        <StackPanel Margin="0,2,0,6">
                            <RadioButton Content="From the delivered MU (recommended)" IsChecked="{Binding AxisMu}" GroupName="Axis" />
                            <RadioButton Content="From the log's control point (tracks the expected MU)" IsChecked="{Binding AxisMu, Converter={StaticResource Not}}" GroupName="Axis" />
                        </StackPanel>
                        <TextBlock Text="Gantry angles without a template" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <RadioButton Content="Plan (expected)" IsChecked="{Binding GantryFromPlan}" GroupName="Gantry" Margin="0,0,16,0" />
                            <RadioButton Content="Actual" IsChecked="{Binding GantryFromPlan, Converter={StaticResource Not}}" GroupName="Gantry" />
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Angle scale of the log" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="Minimum leaf gap (mm)" VerticalAlignment="Center" Margin="0,6,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinGap}" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="Empty = the MLC's (0.5 mm for SX2)" />
                            <TextBlock Grid.Row="2" Text="MLC model (no template)" VerticalAlignment="Center" Margin="0,6,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MlcModel}" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="Empty = the log's MLC (e.g. SX2)" />
                        </Grid>
                        <CheckBox Content="Also use beam-hold snapshots (not recommended)" IsChecked="{Binding IncludeHold}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Output folder" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Writes &lt;log&gt;[_subN]_reconstructed_MLC.csv and a _report.txt for each field." />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Reconstruct" Command="{Binding RunCommand}" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="Open folder" Command="{Binding OpenOutputCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: results -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Field" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" DisplayMemberPath="Summary" MinWidth="420" />
                <ProgressBar IsIndeterminate="True" Width="80" Height="6" Margin="12,0,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TabControl Grid.Row="1">
                <TabItem Header="QA report">
                    <TextBox Text="{Binding SelectedReport, Mode=OneWay}" Style="{StaticResource Mono}" />
                </TabItem>
                <TabItem Header="Difference">
                    <sp:WpfPlot x:Name="DiffPlot" />
                </TabItem>
                <TabItem Header="Leaf">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding SelectedValueName}" Width="90" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="{Binding MaxValue}" Value="{Binding SelectedValue}" IsSnapToTickEnabled="True" TickFrequency="1" Width="400" />
                        </StackPanel>
                        <sp:WpfPlot Grid.Row="1" x:Name="LeafPlot" />
                    </Grid>
                </TabItem>
                <TabItem Header="Run log">
                    <TextBox Text="{Binding RunLog, Mode=OneWay}" Style="{StaticResource Mono}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
