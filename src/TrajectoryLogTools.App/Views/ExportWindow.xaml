<Window x:Class="TrajectoryLogTools.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TrajectoryLogTools.App.ViewModels"
        xmlns:views="clr-namespace:TrajectoryLogTools.App.Views"
        Title="{Binding Title}" Width="780" Height="760" MinWidth="640" MinHeight="520"
        Background="{DynamicResource ApplicationBackgroundBrush}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="24,18,24,16">
        <!-- Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="16,6" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Export" Command="{Binding ExportCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="8,0,0,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Padding="16,6"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Left" Content="Open folder" Command="{Binding OpenFolderCommand}" Padding="12,6"
                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,10" />

                <!-- What to write -->
                <TextBlock Text="What to write" Style="{StaticResource SectionTitle}" />
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Box}" Margin="0,0,8,8">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ToV4}" Content="v4.0 log (.bin)" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding V4Note}" Style="{StaticResource Hint}" Margin="28,2,0,6" />
                            <StackPanel Margin="28,0,0,0" IsEnabled="{Binding ToV4}">
                                <TextBlock Text="Machine" Style="{StaticResource Secondary}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <RadioButton Content="TrueBeam (0)" IsChecked="{Binding MachineHalcyon, Converter={StaticResource Not}}" GroupName="Machine" Margin="0,0,12,0" />
                                    <RadioButton Content="Halcyon (1)" IsChecked="{Binding MachineHalcyon}" GroupName="Machine" />
                                </StackPanel>
                                <TextBlock Text="Serial number" Style="{StaticResource Secondary}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton Content="Remove" IsChecked="{Binding RemoveSerial}" GroupName="Serial" Margin="0,0,12,0" />
                                    <RadioButton Content="Keep" IsChecked="{Binding KeepSerial}" GroupName="Serial" Margin="0,0,12,0" />
                                    <RadioButton Content="Change to" IsChecked="{Binding ChangeSerial}" GroupName="Serial" />
                                </StackPanel>
                                <TextBox Text="{Binding NewSerial, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0"
                                         AutomationProperties.Name="New serial number" ToolTip="Up to 6 characters"
                                         Visibility="{Binding ChangeSerial, Converter={StaticResource BoolToVisibility}}" />
                                <CheckBox Content="Remove couch rotation, pitch and roll" IsChecked="{Binding RemoveCouch}" Margin="0,8,0,0" />
                                <CheckBox Content="Save the removed time axis (_time.csv)" IsChecked="{Binding TimeCsv}" />
                                <!-- One log: patient, plan and field names -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding CanEditHeader, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Header details…" Command="{Binding EditHeaderCommand}" HorizontalAlignment="Left" Padding="10,4"
                                            ToolTip="Change the patient ID, plan name, plan UID or field names written to the v4.0 file" />
                                    <TextBlock Text="{Binding HeaderEditsText}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Box}" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ToCsv}" Content="CSV (.csv)" FontWeight="SemiBold" />
                            <TextBlock Text="One row per 20 ms snapshot, expected and actual for every axis. Opens in Excel." Style="{StaticResource Hint}" Margin="28,2,0,6" />
                            <StackPanel Margin="28,0,0,0" IsEnabled="{Binding ToCsv}">
                                <CheckBox Content="Leave out the MLC columns" IsChecked="{Binding NoMlc}" />
                                <CheckBox Content="Actual values only" IsChecked="{Binding ActualOnly}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Box}" Margin="0,0,8,8">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding FullCsv}" Content="Full dump as CSV (_full.csv)" FontWeight="SemiBold" />
                            <TextBlock Text="The whole file exactly as stored: header fields with byte offsets, subbeams, every value, CRC." Style="{StaticResource Hint}" Margin="28,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Box}" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Dump}" Content="Raw dump as text (.txt)" FontWeight="SemiBold" />
                            <TextBlock Text="The same as readable text. Works on damaged files too." Style="{StaticResource Hint}" Margin="28,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Where -->
                <TextBlock Text="Where" Style="{StaticResource SectionTitle}" Margin="0,10,0,6" />
                <RadioButton Content="One folder for all" IsChecked="{Binding OneFolder}" GroupName="Where" />
                <DockPanel Margin="28,6,0,6" IsEnabled="{Binding OneFolder}">
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Padding="12,5" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Export folder" />
                </DockPanel>
                <RadioButton Content="Next to each log, in a &quot;converted&quot; subfolder" IsChecked="{Binding OneFolder, Converter={StaticResource Not}}" GroupName="Where" />
                <CheckBox Content="Overwrite existing files" IsChecked="{Binding Overwrite}" Margin="0,10,0,0" />
                <CheckBox Content="Also process logs whose CRC does not verify" IsChecked="{Binding IgnoreCrc}" Margin="0,4,0,0"
                          Visibility="{Binding AnyCrcFailed, Converter={StaticResource BoolToVisibility}}" />

                <!-- Logs and progress -->
                <TextBlock Text="Logs" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,6"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExportRow}">
                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <DockPanel>
                                    <views:StatusChip DockPanel.Dock="Right" Text="{Binding Status}" Kind="{Binding StatusKind}"
                                                      Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" ToolTip="{Binding Log.Path}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                                   Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
