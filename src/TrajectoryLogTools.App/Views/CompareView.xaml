<UserControl x:Class="TrajectoryLogTools.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log A" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PathA, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseACommand}" Margin="8,0,0,0" MinWidth="90" />
                    <TextBlock Grid.Row="1" Text="Log B" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PathB, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" VerticalContentAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseBCommand}" Margin="8,6,0,0" MinWidth="90" />
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <RadioButton Content="Delivery comparison (same field delivered twice)" IsChecked="{Binding IsDeliveryMode}" GroupName="Mode" Margin="0,0,24,0" />
                    <RadioButton Content="File comparison (value by value)" IsChecked="{Binding IsDeliveryMode, Converter={StaticResource Not}}" GroupName="Mode" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox Content="Leave out a stray first snapshot (&gt; 0.5 s before the rest)" IsChecked="{Binding DropStrayFirstSnapshot}"
                              Visibility="{Binding IsDeliveryMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsFileMode, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Ignore v4.0 / v5.1 differences (version, time axis, axis order, machine info)" IsChecked="{Binding IgnoreVersion}" Margin="0,0,24,0" />
                        <TextBlock Text="Tolerance" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Tolerance}" Width="80" />
                    </StackPanel>
                    <CheckBox Content="Ignore CRC" IsChecked="{Binding IgnoreCrc}" Margin="24,0,0,0" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Compare" Command="{Binding RunCommand}" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Swap A / B" Command="{Binding SwapCommand}" MinWidth="100" Margin="8,0,0,0" />
                    <Button Content="Save results..." Command="{Binding ExportResultsCommand}" MinWidth="120" Margin="8,0,0,0" IsEnabled="{Binding HasResult}" />
                    <ProgressBar IsIndeterminate="True" Width="80" Height="6" Margin="12,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding ResultTab}">
            <TabItem Header="Figure">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <sp:WpfPlot x:Name="GantryPlot" />
                    <sp:WpfPlot Grid.Column="1" x:Name="MuPlot" />
                    <sp:WpfPlot Grid.Row="1" x:Name="ExpectedPlot" />
                    <sp:WpfPlot Grid.Row="1" Grid.Column="1" x:Name="ActualPlot" />
                </Grid>
            </TabItem>
            <TabItem Header="By axis">
                <DataGrid ItemsSource="{Binding Summary}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" />
                        <DataGridTextColumn Header="Values" Binding="{Binding Values}" />
                        <DataGridTextColumn Header="Sampling" Binding="{Binding Sampling}" />
                        <DataGridTextColumn Header="Mean A−B" Binding="{Binding Mean}" />
                        <DataGridTextColumn Header="RMS A−B" Binding="{Binding Rms}" />
                        <DataGridTextColumn Header="Max |A−B|" Binding="{Binding Max}" />
                        <DataGridTextColumn Header="P95 |A−B|" Binding="{Binding P95}" />
                        <DataGridTextColumn Header="P99 |A−B|" Binding="{Binding P99}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Per beam and holds">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Beams}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Log" Binding="{Binding Log}" />
                            <DataGridTextColumn Header="Beam" Binding="{Binding Beam}" />
                            <DataGridTextColumn Header="Gantry (deg)" Binding="{Binding Gantry}" />
                            <DataGridTextColumn Header="Coll (deg)" Binding="{Binding Coll}" />
                            <DataGridTextColumn Header="CP" Binding="{Binding ControlPoints}" />
                            <DataGridTextColumn Header="MU planned" Binding="{Binding MuPlanned}" />
                            <DataGridTextColumn Header="MU delivered" Binding="{Binding MuDelivered}" />
                            <DataGridTextColumn Header="Beam on (s)" Binding="{Binding BeamOnS}" />
                            <DataGridTextColumn Header="Hold (s)" Binding="{Binding HoldS}" />
                            <DataGridTextColumn Header="MLC RMS err (mm)" Binding="{Binding MlcRms}" />
                            <DataGridTextColumn Header="MLC max err (mm)" Binding="{Binding MlcMax}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Holds}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Log" Binding="{Binding Log}" />
                            <DataGridTextColumn Header="Hold type" Binding="{Binding Type}" />
                            <DataGridTextColumn Header="Beam" Binding="{Binding Beam}" />
                            <DataGridTextColumn Header="Start (s)" Binding="{Binding Start}" />
                            <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" />
                            <DataGridTextColumn Header="CP" Binding="{Binding ControlPoint}" />
                            <DataGridTextColumn Header="MU" Binding="{Binding Mu}" />
                            <DataGridTextColumn Header="Gantry" Binding="{Binding Gantry}" />
                            <DataGridTextColumn Header="Coll" Binding="{Binding Coll}" />
                            <DataGridTextColumn Header="Leaf err during (mm)" Binding="{Binding LeafErr}" />
                            <DataGridTextColumn Header="Leaf err 1 s after (mm)" Binding="{Binding LeafErrAfter}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Report">
                <TextBox Text="{Binding ReportText, Mode=OneWay}" Style="{StaticResource Mono}" />
            </TabItem>
            <TabItem Header="File comparison">
                <TextBox Text="{Binding FileCompareText, Mode=OneWay}" Style="{StaticResource Mono}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
