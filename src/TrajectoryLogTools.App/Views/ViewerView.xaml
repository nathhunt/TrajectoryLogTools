<UserControl x:Class="TrajectoryLogTools.App.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Open..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" MinWidth="90" />
            <Button Grid.Column="2" Content="Reload" Command="{Binding ReloadCommand}" Margin="8,0,0,0" MinWidth="80" />
            <CheckBox Grid.Column="3" Content="Ignore CRC" IsChecked="{Binding IgnoreCrc}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="4" IsIndeterminate="True" Width="80" Height="6" Margin="12,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBox Text="{Binding HeaderText, Mode=OneWay}" Style="{StaticResource Mono}" BorderThickness="0" />
                        <WrapPanel Margin="0,8" IsEnabled="{Binding HasLog}">
                            <Button Content="Compare with another delivery..." Command="{Binding SendToCompareCommand}" Margin="0,0,8,0" />
                            <Button Content="Reconstruct Eclipse MLC..." Command="{Binding SendToMlcCommand}" Margin="0,0,8,0" />
                            <Button Content="Export CSV..." Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsBin}" />
                            <Button Content="Export full CSV..." Command="{Binding ExportFullCsvCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsBin}" />
                            <Button Content="Export raw dump..." Command="{Binding ExportDumpCommand}" IsEnabled="{Binding IsBin}" />
                        </WrapPanel>

                        <TextBlock Text="Subbeams (from the header)" Style="{StaticResource SectionTitle}" Margin="0,8,0,4" />
                        <DataGrid ItemsSource="{Binding Subbeams}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Start CP" Binding="{Binding ControlPoint}" />
                                <DataGridTextColumn Header="MU" Binding="{Binding Mu}" />
                                <DataGridTextColumn Header="Radiation time (s)" Binding="{Binding RadiationTime}" />
                                <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Delivery per subbeam" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                        <DataGrid ItemsSource="{Binding Beams}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Beam" Binding="{Binding Beam}" />
                                <DataGridTextColumn Header="Gantry (deg)" Binding="{Binding Gantry}" />
                                <DataGridTextColumn Header="Coll (deg)" Binding="{Binding Coll}" />
                                <DataGridTextColumn Header="CP" Binding="{Binding ControlPoints}" />
                                <DataGridTextColumn Header="MU planned" Binding="{Binding MuPlanned}" />
                                <DataGridTextColumn Header="MU delivered" Binding="{Binding MuDelivered}" />
                                <DataGridTextColumn Header="Beam on (s)" Binding="{Binding BeamOnS}" />
                                <DataGridTextColumn Header="Hold (s)" Binding="{Binding HoldS}" />
                                <DataGridTextColumn Header="MLC RMS err (mm)" Binding="{Binding MlcRms}" />
                                <DataGridTextColumn Header="MLC max err (mm)" Binding="{Binding MlcMax}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding TotalsText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Beam holds" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="start / end = log edges; move = gantry or collimator moved (planned transition between beams or arcs); interruption = nothing moved." />
                        <DataGrid ItemsSource="{Binding Holds}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="Beam" Binding="{Binding Beam}" />
                                <DataGridTextColumn Header="Start (s)" Binding="{Binding Start}" />
                                <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" />
                                <DataGridTextColumn Header="CP" Binding="{Binding ControlPoint}" />
                                <DataGridTextColumn Header="MU" Binding="{Binding Mu}" />
                                <DataGridTextColumn Header="Gantry" Binding="{Binding Gantry}" />
                                <DataGridTextColumn Header="Coll" Binding="{Binding Coll}" />
                                <DataGridTextColumn Header="Leaf err during (mm)" Binding="{Binding LeafErr}" />
                                <DataGridTextColumn Header="Leaf err 1 s after (mm)" Binding="{Binding LeafErrAfter}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Axes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="Axis" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" DisplayMemberPath="Value" MinWidth="220" />
                        <CheckBox Content="Plot against control point (instead of time)" IsChecked="{Binding VsControlPoint}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Text="Scroll to zoom, drag to pan, double-click to reset." />
                    </StackPanel>
                    <sp:WpfPlot Grid.Row="1" x:Name="AxisPlot" />
                    <sp:WpfPlot Grid.Row="2" x:Name="ErrorPlot" />
                </Grid>
            </TabItem>

            <TabItem Header="MLC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <CheckBox Content="Plot against control point (instead of time)" IsChecked="{Binding VsControlPoint}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Text="Actual minus expected leaf position, beam on only. Scroll to zoom, drag to pan, double-click to reset." />
                    </StackPanel>
                    <sp:WpfPlot Grid.Row="1" x:Name="MlcPlot" />
                </Grid>
            </TabItem>

            <TabItem Header="Raw dump">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Button Content="Show raw dump" Command="{Binding ShowRawDumpCommand}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="Every byte of the file as stored: header fields with offsets, subbeams, every snapshot value, CRC. Works on damaged files." />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding RawDump, Mode=OneWay}" Style="{StaticResource Mono}" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
