<UserControl x:Class="TrajectoryLogTools.App.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrajectoryLogTools.App.ViewModels"
             xmlns:views="clr-namespace:TrajectoryLogTools.App.Views"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="22,18,22,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Compare with…" Command="{Binding CompareWithCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Pick another log to compare this one with" />
                <Button Content="Rebuild Eclipse MLC…" Command="{Binding RebuildCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="This log; if it is ticked, all the ticked logs" />
                <Button Content="Export…" Command="{Binding ExportCommand}" Padding="12,6" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource PageTitle}">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding TitleSuffix, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" />
                </TextBlock>
                <views:PatientTag Id="{Binding Item.PatientId}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0" ToolTip="{Binding Item.Path}" />
            </StackPanel>
        </DockPanel>

        <!-- Banners -->
        <Border DockPanel.Dock="Top" Margin="22,12,22,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
        <Border DockPanel.Dock="Top" Margin="22,12,22,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding CrcWarning, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding CrcWarning}" TextWrapping="Wrap" />
        </Border>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="22,10,22,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- Key facts -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactCard}" Margin="22,14,12,12" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="16,0,16,12">
            <!-- ================= Overview ================= -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12,6,0">
                    <StackPanel>
                        <TextBlock Text="Delivery timeline" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Timeline}" Height="30" Focusable="False" x:Name="TimelineBar">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineSegment}">
                                    <Border Height="30" ToolTip="{Binding ToolTip}" ClipToBounds="True">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                <Binding Path="Fraction" />
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="on">
                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="on2">
                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="interruption">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding TimelineTicks}" Margin="0,4,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Secondary}" FontSize="11" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Beam on (shades alternate by field)" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Interruption (nothing moved)" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource TextFillColorDisabledBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Planned hold (start, end, gantry / collimator move). Hover for details." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Fields" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                        <DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding Name}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Gantry (IEC)" Binding="{Binding Gantry}" />
                                <DataGridTextColumn Header="Collimator" Binding="{Binding Collimator}" />
                                <DataGridTextColumn Header="Control points" Binding="{Binding ControlPoints}" />
                                <DataGridTextColumn Header="MU planned" Binding="{Binding MuPlanned}" />
                                <DataGridTextColumn Header="MU delivered" Binding="{Binding MuDelivered}" />
                                <DataGridTextColumn Header="Beam on" Binding="{Binding BeamOn}" />
                                <DataGridTextColumn Header="MLC RMS" Binding="{Binding MlcRms}" />
                                <DataGridTextColumn Header="MLC max" Binding="{Binding MlcMax}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Expander Header="Beam holds" Margin="0,18,0,0">
                            <DataGrid ItemsSource="{Binding Holds}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0"
                                      CanUserAddRows="False" HorizontalScrollBarVisibility="Auto" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                                    <DataGridTextColumn Header="Field" Binding="{Binding Log}" />
                                    <DataGridTextColumn Header="Start (s)" Binding="{Binding Start}" />
                                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" />
                                    <DataGridTextColumn Header="Control point" Binding="{Binding ControlPoint}" />
                                    <DataGridTextColumn Header="MU" Binding="{Binding Mu}" />
                                    <DataGridTextColumn Header="Gantry" Binding="{Binding Gantry}" />
                                    <DataGridTextColumn Header="Collimator" Binding="{Binding Coll}" />
                                    <DataGridTextColumn Header="Leaf error during (mm)" Binding="{Binding LeafErr}" />
                                    <DataGridTextColumn Header="1 s after (mm)" Binding="{Binding LeafErrAfter}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="Header and metadata" Margin="0,8,0,16">
                            <TextBox Text="{Binding HeaderDetails, Mode=OneWay}" Style="{StaticResource Mono}" Margin="0,8,0,0" BorderThickness="0" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Axes ================= -->
            <TabItem Header="Axes">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" DisplayMemberPath="Value" Margin="0,0,10,0"
                             AutomationProperties.Name="Axis to plot" />
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Plot against control point (instead of time)" IsChecked="{Binding VsControlPoint}" />
                            <TextBlock Text="Ctrl + scroll to zoom · drag to pan · double-click to reset" Style="{StaticResource Secondary}" Margin="18,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>
                            <sp:WpfPlot x:Name="AxisPlot" />
                            <sp:WpfPlot Grid.Row="1" x:Name="ErrorPlot" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= MLC ================= -->
            <TabItem Header="MLC">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Content="Plot against control point (instead of time)" IsChecked="{Binding VsControlPoint}" />
                        <TextBlock Text="Actual − expected leaf position, beam on only · scroll to zoom · drag to pan · double-click to reset"
                                   Style="{StaticResource Secondary}" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding WorstLeaves}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <sp:WpfPlot x:Name="MlcPlot" />
                        <sp:WpfPlot Grid.Column="1" x:Name="RmsPlot" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Raw ================= -->
            <TabItem Header="Raw">
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Find next" Click="FindNext_Click" Padding="12,5" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Every byte of the file as stored: header fields with offsets, subbeams, every value, CRC."
                                   Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid>
                            <TextBox x:Name="FindBox" KeyDown="FindBox_KeyDown" AutomationProperties.Name="Find in the dump" />
                            <TextBlock Text="Find (e.g. Subbeam, MLC model, CRC)" Style="{StaticResource Secondary}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=FindBox, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Visibility="{Binding RawLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox x:Name="RawBox" Text="{Binding RawDump, Mode=OneWay}" Style="{StaticResource Mono}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
