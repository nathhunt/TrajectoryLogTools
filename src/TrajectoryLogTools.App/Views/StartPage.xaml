<UserControl x:Class="TrajectoryLogTools.App.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrajectoryLogTools.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <!-- Drop zone -->
            <Border Width="480" BorderThickness="2" CornerRadius="12" Padding="40,48" Margin="0,0,32,24"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Open trajectory logs" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,8" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" MaxWidth="380" FontSize="13"
                               Text="Drop .bin logs or folders anywhere in this window. Logs can come from different folders and drives; each keeps its own location." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Command="{Binding Main.OpenCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="18,8" Content="Open files…" />
                        <Button Command="{Binding Main.AddFromFolderDialogCommand}" Padding="18,8" Margin="10,0,0,0" Content="Add from folder…" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0"
                               Text="Add from folder can include subfolders and only logs treated between two dates." />
                </StackPanel>
            </Border>

            <!-- Recent -->
            <StackPanel Width="400" Margin="0,0,0,24">
                <TextBlock Text="Recent logs" Style="{StaticResource SectionTitle}" FontSize="15" />
                <TextBlock Text="Files you opened recently." Style="{StaticResource Hint}" Margin="0,-4,0,8" />
                <TextBlock Text="None yet." Style="{StaticResource Hint}"
                           Visibility="{Binding Main.RecentFiles.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Main.RecentFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.Main.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,4" ToolTip="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Converter={x:Static local:PathParts.FileName}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Converter={x:Static local:PathParts.Folder}}" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Box}" Margin="0,14,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderThickness="0">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Started from Eclipse? A log passed by the launcher opens straight away. Settings (top right) hold the theme and optional compare tolerances." />
                </Border>
            </StackPanel>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
