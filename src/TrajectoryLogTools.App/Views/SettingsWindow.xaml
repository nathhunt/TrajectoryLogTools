<Window x:Class="TrajectoryLogTools.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}" ShowInTaskbar="False">
    <StackPanel Margin="24,18,24,18">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

        <TextBlock Text="Theme" Style="{StaticResource SectionTitle}" />
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Theme" />

        <TextBlock Text="Compare tolerances" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Optional. When set, the Compare page marks each difference as within or over the tolerance. Leave empty to show the numbers only." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="MLC actual, max |A − B| (mm)" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MlcTolerance}" AutomationProperties.Name="MLC tolerance in mm" />
            <TextBlock Grid.Row="1" Text="Gantry actual, max |A − B| (°)" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GantryTolerance}" Margin="0,8,0,0" AutomationProperties.Name="Gantry tolerance in degrees" />
            <TextBlock Grid.Row="2" Text="MU actual, max |A − B| (MU)" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MuTolerance}" Margin="0,8,0,0" AutomationProperties.Name="MU tolerance" />
        </Grid>

        <TextBlock Text="Recent logs" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
        <Button Content="Clear the recent logs list" Command="{Binding ClearRecentCommand}" HorizontalAlignment="Left" Padding="12,5" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" Padding="18,6" IsDefault="True" />
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
