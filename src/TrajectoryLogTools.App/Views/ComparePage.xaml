<UserControl x:Class="TrajectoryLogTools.App.Views.ComparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TrajectoryLogTools.App.Views"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel>
        <!-- A / B -->
        <DockPanel DockPanel.Dock="Top" Margin="22,18,22,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Swap A / B" Command="{Binding SwapCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="Save report…" Command="{Binding SaveReportCommand}" Padding="12,6" Style="{DynamicResource AccentButtonStyle}"
                        IsEnabled="{Binding HasResult}" ToolTip="Report, tables and figure to a folder" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Compare deliveries" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                <Border x:Name="DropA" AllowDrop="True" Drop="DropA_Drop" DragOver="Drop_DragOver" Background="Transparent" Padding="0,2"
                        ToolTip="Drop a log here to compare it as A">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="A" Foreground="{DynamicResource SolidBackgroundFillColorBaseBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" Content="Change…" Command="{Binding BrowseACommand}" Style="{StaticResource LinkButton}" FontSize="12" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathA}">
                            <Run Text="{Binding DateA, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding PathA, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <Border x:Name="DropB" AllowDrop="True" Drop="DropB_Drop" DragOver="Drop_DragOver" Background="Transparent" Padding="0,2" Margin="0,4,0,0"
                        ToolTip="Drop a log here to compare it as B">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="B" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" Content="Change…" Command="{Binding BrowseBCommand}" Style="{StaticResource LinkButton}" FontSize="12" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathB}">
                            <Run Text="{Binding DateB, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding PathB, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="22,10,22,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,12,22,16">
            <StackPanel>
                <Border Padding="12,8" CornerRadius="6" Margin="0,0,0,12" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>

                <!-- Verdict -->
                <Border Padding="12,8" CornerRadius="6" Margin="0,0,0,12" Visibility="{Binding Verdict, Converter={StaticResource NotEmptyToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerdictKind}" Value="caution">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource FactCard}" Margin="0,0,-10,14" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Charts -->
                <Grid Height="380" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Box}" Padding="4" Margin="0,0,10,0">
                        <sp:WpfPlot x:Name="ActualPlot" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Box}" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <sp:WpfPlot x:Name="GantryPlot" />
                            <sp:WpfPlot Grid.Row="1" x:Name="MuPlot" />
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Text="Matched by control point using beam-on samples only, so timing, beam holds and sampling don't affect the comparison. Scroll to zoom · drag to pan · double-click to reset."
                           Style="{StaticResource Hint}" Margin="0,6,0,12" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />

                <!-- Details -->
                <Expander Header="Planned (expected) leaf differences" Margin="0,0,0,6" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Box}" Padding="4" Height="300" Margin="0,8,0,0">
                        <sp:WpfPlot x:Name="ExpectedPlot" />
                    </Border>
                </Expander>
                <Expander Header="Per field, A and B" Margin="0,0,0,6" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid ItemsSource="{Binding Beams}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Log" Binding="{Binding Log}" />
                            <DataGridTextColumn Header="Field" Binding="{Binding Beam}" />
                            <DataGridTextColumn Header="Gantry (log scale)" Binding="{Binding Gantry}" />
                            <DataGridTextColumn Header="Control points" Binding="{Binding ControlPoints}" />
                            <DataGridTextColumn Header="MU planned" Binding="{Binding MuPlanned}" />
                            <DataGridTextColumn Header="MU delivered" Binding="{Binding MuDelivered}" />
                            <DataGridTextColumn Header="Beam on (s)" Binding="{Binding BeamOnS}" />
                            <DataGridTextColumn Header="Hold (s)" Binding="{Binding HoldS}" />
                            <DataGridTextColumn Header="MLC RMS (mm)" Binding="{Binding MlcRms}" />
                            <DataGridTextColumn Header="MLC max (mm)" Binding="{Binding MlcMax}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                <Expander Header="Beam holds, A and B" Margin="0,0,0,6" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid ItemsSource="{Binding Holds}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Log" Binding="{Binding Log}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                            <DataGridTextColumn Header="Field" Binding="{Binding Beam}" />
                            <DataGridTextColumn Header="Start (s)" Binding="{Binding Start}" />
                            <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" />
                            <DataGridTextColumn Header="Control point" Binding="{Binding ControlPoint}" />
                            <DataGridTextColumn Header="Gantry" Binding="{Binding Gantry}" />
                            <DataGridTextColumn Header="Collimator" Binding="{Binding Coll}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                <Expander Header="By axis (all statistics)" Margin="0,0,0,6" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid ItemsSource="{Binding Axes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" />
                            <DataGridTextColumn Header="Values" Binding="{Binding Values}" />
                            <DataGridTextColumn Header="Sampling" Binding="{Binding Sampling}" />
                            <DataGridTextColumn Header="Mean A−B" Binding="{Binding Mean}" />
                            <DataGridTextColumn Header="RMS A−B" Binding="{Binding Rms}" />
                            <DataGridTextColumn Header="Max |A−B|" Binding="{Binding Max}" />
                            <DataGridTextColumn Header="P95 |A−B|" Binding="{Binding P95}" />
                            <DataGridTextColumn Header="P99 |A−B|" Binding="{Binding P99}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                <Expander Header="File differences (validation)" Margin="0,0,0,6">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Header, subbeams and every stored value, e.g. to check a v4.0 conversion against its v5.1 original. Needs two .bin logs." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Compare the files" Command="{Binding CompareFilesCommand}" IsEnabled="{Binding CanCompareFiles}" Padding="12,5" />
                            <CheckBox Content="Ignore what differs between v4.0 and v5.1 by design" IsChecked="{Binding FileIgnoreVersion}" Margin="14,0,0,0" />
                        </StackPanel>
                        <TextBox Text="{Binding FileComparison, Mode=OneWay}" Style="{StaticResource Mono}" MaxHeight="300"
                                 Visibility="{Binding FileComparison, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Expander>
                <Expander Header="Full report" Margin="0,0,0,6" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding Report, Mode=OneWay}" Style="{StaticResource Mono}" MaxHeight="400" Margin="0,8,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
