<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes the deployable folder: the GUI, the command-line tool and the Eclipse launcher script,
     self-contained (no .NET install needed on the workstations).
       Visual Studio: right-click TrajectoryLogTools.App > Publish > Deploy > Publish
       VS Code:       Terminal > Run Task > publish
       Command line:  dotnet publish src/TrajectoryLogTools.App -p:PublishProfile=Deploy
     Output: Deploy\TrajectoryLogTools\ at the repository root. To publish somewhere else, e.g. a share:
       dotnet publish src/TrajectoryLogTools.App -p:PublishProfile=Deploy -p:PublishDir=\\server\ESAPI\TrajectoryLogTools\ -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Deploy\TrajectoryLogTools\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
