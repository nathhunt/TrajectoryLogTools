<Project Sdk="Microsoft.NET.Sdk">
  <!-- Trajectory Log Tools: the Windows GUI (WPF, .NET 10). Published self-contained to a folder,
       so the Eclipse workstations need no .NET install: see scripts/publish.ps1 or
       Properties/PublishProfiles/Deploy.pubxml (Visual Studio: right-click > Publish). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: the Windows SDK version ScottPlot's WPF control (SkiaSharp.Views.WPF) is built for.
         It is a build-time setting; the app still runs on older Windows: -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1607 / Windows Server 2016 and later. -->
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrajectoryLogTools.App</RootNamespace>
    <AssemblyName>TrajectoryLogTools</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon (Explorer, taskbar, shortcuts); WPF windows use it too. Drawn by scripts/make_icons.py. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Application.ThemeMode (Fluent theme) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Only English UI resources in the published folder. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>
  <ItemGroup>
    <!-- The documentation screenshot tool keeps the settings in memory (AppSettings.UseInMemory). -->
    <InternalsVisibleTo Include="TrajectoryLogTools.DocShots" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrajectoryLogTools.Analysis\TrajectoryLogTools.Analysis.csproj" />
    <ProjectReference Include="..\TrajectoryLogTools.Charts\TrajectoryLogTools.Charts.csproj" />
    <ProjectReference Include="..\TrajectoryLogTools.Wpf\TrajectoryLogTools.Wpf.csproj" />
  </ItemGroup>

  <!-- After publishing the GUI:
       * the command-line tool goes into the same folder (same runtime, so shared files are
         identical), with the Eclipse launcher script;
       * the v4.0 converter is published on its own, self-contained, into a separate folder beside
         this one: Deploy\TrajectoryLogTools\ -> Deploy\TrajectoryLogConverter\ (with its launcher;
         set ConverterPublishDir to put it elsewhere). The two folders share nothing, so each can be
         deployed, moved or removed alone. The converter's settings file
         (TrajectoryLogConverter.settings.json) is not published, so redeploying keeps it. -->
  <Target Name="PublishCliAndLauncher" AfterTargets="Publish" Condition=" '$(RuntimeIdentifier)' != '' ">
    <PropertyGroup>
      <ConverterPublishDir Condition=" '$(ConverterPublishDir)' == '' ">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(PublishDir), '..', 'TrajectoryLogConverter'))))</ConverterPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\TrajectoryLogTools.Cli\TrajectoryLogTools.Cli.csproj" Targets="Restore;Publish" RemoveProperties="PublishProfile"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir);_DummyToForceRestore=$(MSBuildProjectFullPath)" />
    <Copy SourceFiles="..\..\launcher\LaunchTrajectoryLogTools.cs" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <MSBuild Projects="..\TrajectoryLogTools.Converter\TrajectoryLogTools.Converter.csproj" Targets="Restore;Publish" RemoveProperties="PublishProfile"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(ConverterPublishDir)\;_DummyToForceRestore=$(MSBuildProjectFullPath)" />
    <Message Importance="high" Text="Deploy folder: $([System.IO.Path]::GetFullPath($(PublishDir)))" />
    <Message Importance="high" Text="Converter deploy folder: $(ConverterPublishDir)" />
  </Target>

  <!-- The user guide (Help\ beside the exe) -->
  <Import Project="..\Help.targets" />
</Project>
