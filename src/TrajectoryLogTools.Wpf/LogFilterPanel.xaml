<UserControl x:Class="TrajectoryLogTools.Wpf.LogFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:TrajectoryLogTools.Wpf"
             Focusable="False">
    <!-- The filter by treatment date and time (DataContext: a LogFilter). -->
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/TrajectoryLogTools.Wpf;component/Styles.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <!-- Period: start date and time to end date and time -->
        <CheckBox Content="Only logs treated in this period" IsChecked="{Binding UseDateRange}" />
        <Grid Margin="28,6,0,0" IsEnabled="{Binding UseDateRange}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="From" VerticalAlignment="Center" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Width="150" AutomationProperties.Name="Period start date" />
            <wpf:TimePicker Grid.Column="2" Time="{Binding FromTime}" Margin="8,0,0,0" AutomationProperties.Name="Period start time" />
            <TextBlock Grid.Row="1" Text="To" VerticalAlignment="Center" Margin="0,6,0,0" />
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding ToDate}" Width="150" Margin="0,6,0,0" AutomationProperties.Name="Period end date" />
            <wpf:TimePicker Grid.Row="1" Grid.Column="2" Time="{Binding ToTime}" Margin="8,6,0,0" AutomationProperties.Name="Period end time" />
        </Grid>

        <!-- Time of day, on every day -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox Content="Only at times of day between" IsChecked="{Binding UseTimeOfDay}" VerticalAlignment="Center" />
            <wpf:TimePicker Time="{Binding DayFromTime}" Margin="8,0" IsEnabled="{Binding UseTimeOfDay}" AutomationProperties.Name="Time of day from" />
            <TextBlock Text="and" VerticalAlignment="Center" />
            <wpf:TimePicker Time="{Binding DayToTime}" Margin="8,0" IsEnabled="{Binding UseTimeOfDay}" AutomationProperties.Name="Time of day to" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                   Text="On every day (within the period, if that is ticked too), e.g. the morning sessions of a week. 22:00 to 02:00 runs past midnight." />
    </StackPanel>
</UserControl>
