<UserControl x:Class="TrajectoryLogTools.Wpf.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/TrajectoryLogTools.Wpf;component/Styles.xaml" />
    </UserControl.Resources>
    <!--
        A 24-hour time picker in the style of the Windows one: a button showing the time, which opens
        a drop-down with the hours and the minutes side by side. The mouse wheel or the arrow keys on
        the button change the time a minute at a time (Shift: an hour).
    -->
    <Grid>
        <ToggleButton x:Name="Button" IsChecked="{Binding IsOpen, ElementName=Popup, Mode=TwoWay}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Popup, Converter={StaticResource Not}}" HorizontalContentAlignment="Stretch"
                      Padding="10,5,8,5" MinWidth="96" AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                      PreviewMouseWheel="Button_PreviewMouseWheel" PreviewKeyDown="Button_PreviewKeyDown"
                      ToolTip="Click to choose; or scroll or use the arrow keys (Shift: an hour at a time)">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE823;" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="Shown" Text="00:00" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI" />
            </DockPanel>
        </ToggleButton>
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Button}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Opened="Popup_Opened">
            <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hour" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,4" />
                        <TextBlock Grid.Column="1" Text="Minute" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,4" />
                    </Grid>
                    <Grid Height="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="Hours" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center"
                                 SelectionChanged="Part_SelectionChanged" AutomationProperties.Name="Hour" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <ListBox x:Name="Minutes" Grid.Column="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center"
                                 SelectionChanged="Part_SelectionChanged" AutomationProperties.Name="Minute" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                    <Button Content="Done" Click="Done_Click" HorizontalAlignment="Stretch" Margin="4,6,4,2" Padding="0,4" IsDefault="False" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
