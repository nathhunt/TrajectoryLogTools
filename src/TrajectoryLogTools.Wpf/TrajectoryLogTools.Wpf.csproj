<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the two Windows apps share: the styles and converters (Styles.xaml), the time picker and
       log filter panel, dialogs, error log, NZ dates and the mouse-wheel rule. Trajectory Log Tools
       (TrajectoryLogTools.App) and the v4.0 converter (TrajectoryLogTools.Converter) both use it,
       so they look and behave the same. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrajectoryLogTools.Wpf</RootNamespace>
    <AssemblyName>TrajectoryLogTools.Wpf</AssemblyName>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrajectoryLogTools.Core\TrajectoryLogTools.Core.csproj" />
  </ItemGroup>
</Project>
