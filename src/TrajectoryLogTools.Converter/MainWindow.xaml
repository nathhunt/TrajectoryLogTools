<Window x:Class="TrajectoryLogTools.Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrajectoryLogTools.Converter"
        xmlns:wpf="clr-namespace:TrajectoryLogTools.Wpf;assembly=TrajectoryLogTools.Wpf"
        Title="{Binding Title}" Width="1000" Height="860" MinWidth="760" MinHeight="620"
        Background="{DynamicResource ApplicationBackgroundBrush}" ResizeMode="CanResizeWithGrip">
    <!--
        One page: where the logs come from (the default folder, filtered, or one file), where they go,
        then the list of what will be converted and Convert. The settings above don't scroll; the list
        fills the rest of the window and scrolls on its own.
    -->
    <DockPanel Margin="24,16,24,14">
        <!-- ======== Title ======== -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="HelpButton" Command="ApplicationCommands.Help" ToolTip="Help: the user guide (F1)" AutomationProperties.Name="Help"
                    Padding="10,6" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" Margin="0,0,6,0" />
                    <TextBlock Text="Help" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" x:Name="SettingsButton" Command="{Binding ShowSettingsCommand}" ToolTip="Settings: the default folders" AutomationProperties.Name="Settings"
                    Padding="10,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,6,0" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Convert trajectory logs to v4.0" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding FixedOptions}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Message (settings missing or unreadable) -->
        <Border DockPanel.Dock="Top" Padding="12,8" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding DismissMessageCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Padding="6,3" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                </Button>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Version, Windows, .NET, folder -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding EnvironmentText}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,6,0,0" Opacity="0.8" />

        <!-- ======== From / To ======== -->
        <Grid DockPanel.Dock="Top" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- From -->
            <Border Style="{StaticResource Box}">
                <StackPanel>
                    <TextBlock Text="From" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Logs in a folder" IsChecked="{Binding FolderMode, Converter={StaticResource RadioIs}, ConverterParameter=true}" GroupName="From" Margin="0,0,20,0" />
                        <RadioButton Content="One file" IsChecked="{Binding FolderMode, Converter={StaticResource RadioIs}, ConverterParameter=false}" GroupName="From" />
                    </StackPanel>

                    <!-- the folder, filtered -->
                    <StackPanel Visibility="{Binding FolderMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseInputCommand}" Padding="12,5" Margin="8,0,0,0" />
                            <TextBox Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged, Delay=500}" AutomationProperties.Name="Input folder" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Back to the default folder" Command="{Binding DefaultInputCommand}" Style="{StaticResource LinkButton}" FontSize="12"
                                    Visibility="{Binding InputIsDefault, Converter={StaticResource InverseBoolToVisibility}}" />
                            <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" />
                        </DockPanel>
                        <wpf:LogFilterPanel DataContext="{Binding Filter}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- one file -->
                    <StackPanel Visibility="{Binding FolderMode, Converter={StaticResource InverseBoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Choose file…" Command="{Binding PickFileCommand}" Padding="12,5" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
                            <TextBox Text="{Binding SingleFile, UpdateSourceTrigger=PropertyChanged, Delay=500}" AutomationProperties.Name="Log to convert" />
                        </DockPanel>
                        <TextBlock Text="The log goes to the output folder, as the folder's logs do." Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- To -->
            <Border Grid.Column="2" Style="{StaticResource Box}">
                <StackPanel>
                    <TextBlock Text="To" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputCommand}" Padding="12,5" Margin="8,0,0,0" />
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged, Delay=500}" AutomationProperties.Name="Output folder" />
                    </DockPanel>
                    <Button Content="Back to the default folder" Command="{Binding DefaultOutputCommand}" Style="{StaticResource LinkButton}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"
                            Visibility="{Binding OutputIsDefault, Converter={StaticResource InverseBoolToVisibility}}" />
                    <CheckBox Content="Replace logs already in the output folder" IsChecked="{Binding Overwrite}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Each log keeps its file name. The default folders are set in Settings; a folder chosen here is for this session." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======== Convert ======== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{Binding ConvertText}" Command="{Binding ConvertCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="20,7" />
            <Button DockPanel.Dock="Right" Content="Open output folder" Command="{Binding OpenOutputCommand}" Padding="12,7" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Result}" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>

        <!-- ======== The list ======== -->
        <DockPanel Margin="0,14,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                    <Button Content="All" Command="{Binding SelectAllCommand}" Style="{StaticResource LinkButton}" FontSize="12" />
                    <Button Content="None" Command="{Binding SelectNoneCommand}" Style="{StaticResource LinkButton}" FontSize="12" Margin="4,0" />
                    <Button Command="{Binding RefreshListCommand}" ToolTip="Look in the folder again" AutomationProperties.Name="Refresh" Padding="6,3" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="40" Height="3" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ListSummary}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ListSummary}" />
            </DockPanel>
            <CheckBox DockPanel.Dock="Bottom" Content="{Binding ShowSkippedText}" IsChecked="{Binding ShowSkipped}" Margin="0,6,0,0" />

            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" RowHeight="30"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Logs to convert"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="38">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:LogRow}">
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConvert}" MinWidth="0" Margin="6,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding File, StringFormat='Convert {0}'}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Treated" Binding="{Binding Treated}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Patient · plan · fields" Binding="{Binding Plan}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="File" Binding="{Binding File}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="Subfolder" Binding="{Binding Folder}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="" Width="1.3*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:LogRow}">
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="caution">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="critical">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
