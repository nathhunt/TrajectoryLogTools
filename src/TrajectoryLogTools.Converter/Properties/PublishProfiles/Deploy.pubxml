<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes only the converter, self-contained, with its Eclipse launcher script. Publishing
     Trajectory Log Tools (its Deploy profile) also publishes the converter, into this same separate
     folder beside its own. Use this to publish only the converter:
       dotnet publish src/TrajectoryLogTools.Converter -p:PublishProfile=Deploy
     Output: Deploy\TrajectoryLogConverter\ at the repository root (or -p:PublishDir=...). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Deploy\TrajectoryLogConverter\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
