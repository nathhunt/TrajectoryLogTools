<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes the converter ON ITS OWN, self-contained, with its Eclipse launcher script. Usually not
     needed: publishing Trajectory Log Tools (its Deploy profile) publishes the converter into the same
     folder. Use this to deploy only the converter:
       dotnet publish src/TrajectoryLogTools.Converter -p:PublishProfile=Deploy
     Output: Deploy\TrajectoryLogConverter\ at the repository root (or -p:PublishDir=...). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Deploy\TrajectoryLogConverter\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
