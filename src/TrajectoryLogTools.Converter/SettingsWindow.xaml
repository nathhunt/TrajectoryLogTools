<Window x:Class="TrajectoryLogTools.Converter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}" ShowInTaskbar="False">
    <StackPanel Margin="24,18,24,18">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

        <TextBlock Text="Default input folder (v5.1 logs)" Style="{StaticResource SectionTitle}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseInputCommand}" Padding="12,5" Margin="8,0,0,0" />
            <TextBox Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default input folder" />
        </DockPanel>
        <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,8,0,0" />

        <TextBlock Text="Default output folder (v4.0 logs)" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputCommand}" Padding="12,5" Margin="8,0,0,0" />
            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default output folder" />
        </DockPanel>

        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0">
            <Run Text="Saved beside the app, so everyone using this copy of the app gets the same folders:" />
            <LineBreak /><Run Text="{Binding FilePath, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" Padding="18,6" IsDefault="True" />
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
