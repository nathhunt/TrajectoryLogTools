<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the engine, the analyses and the command-line tool. Runs on any OS:
       dotnet test tests/TrajectoryLogTools.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrajectoryLogTools.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Core\TrajectoryLogTools.Core.csproj" />
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Analysis\TrajectoryLogTools.Analysis.csproj" />
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Cli\TrajectoryLogTools.Cli.csproj" />
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Charts\TrajectoryLogTools.Charts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Outputs of the original tools for the simulated logs (see reference/README.md). -->
    <None Include="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
