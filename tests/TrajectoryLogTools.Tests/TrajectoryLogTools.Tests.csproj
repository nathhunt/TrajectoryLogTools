<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the engine, the analyses and the command-line tool. Runs on any OS:
       dotnet test tests/TrajectoryLogTools.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrajectoryLogTools.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Core\TrajectoryLogTools.Core.csproj" />
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Analysis\TrajectoryLogTools.Analysis.csproj" />
    <ProjectReference Include="..\..\src\TrajectoryLogTools.Cli\TrajectoryLogTools.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Outputs of the original tools for the simulated logs (see reference/README.md). -->
    <None Include="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
